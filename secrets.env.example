# Docker Compose reads this file on the host; it is never mounted in the app.
# Copy to a private path and set LLM_ENV_FILE, or use the default secrets.txt.
# Never commit the filled-in file.

AZURE_OPENAI_CHAT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-nano
AZURE_OPENAI_CHAT_MODEL=gpt-5-nano
AZURE_OPENAI_CHAT_API_VERSION=

AZURE_OPENAI_REASONING_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/chat/completions
AZURE_OPENAI_REASONING_API_KEY=
AZURE_OPENAI_REASONING_DEPLOYMENT=Phi-4-reasoning
AZURE_OPENAI_REASONING_MODEL=Phi-4-reasoning
AZURE_OPENAI_REASONING_API_VERSION=
